# Painel do Supabase → Project Settings → API
# Ambas as chaves abaixo são seguras para expor no browser (protegidas por RLS).
# NUNCA coloque a service_role key em variável NEXT_PUBLIC_ — ela não é usada neste projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Web Push (notificações no celular) — gera uma vez com `npx web-push generate-vapid-keys` e usa
# o MESMO par pra sempre (trocar invalida as inscrições já salvas). A pública pode ficar exposta
# (NEXT_PUBLIC_), a privada NUNCA sai do servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Opcional — só pra lista de nomes das telas públicas de Vagas de Staff (ver
# docs/superpowers/specs/2026-09-13-vagas-leitura-direta-banco-design.md). Painel do Supabase →
# Project Settings → Database → Connection string → aba "Direct connection". Sem essa variável, o
# sistema cai de volta pra consulta normal via API, sem quebrar nada.
SUPABASE_DIRECT_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.SEU-PROJETO.supabase.co:5432/postgres
